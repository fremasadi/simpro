<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SIMPRO">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Halaman login -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- Halaman utama admin -->
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false" />

        <!-- Halaman utama mandor -->
        <activity
            android:name=".ui.mandor.MandorMainActivity"
            android:exported="false" />

        <activity android:name=".ui.user.UserFormActivity" android:exported="false" />

        <activity
            android:name=".ui.barang.BarangFormActivity"
            android:exported="false"             />
        <activity
            android:name=".ui.kemasan.KemasanFormActivity"
            android:exported="false"/>

        <activity
            android:name=".ui.produksi.ProduksiFormActivity"
            android:exported="false"/>

        <activity android:name=".ui.pengeluaran.PengeluaranFormActivity"
            android:exported="false"/>

        <activity android:name=".ui.penjualan.PenjualanFormActivity"
            android:exported="false"/>

    </application>

</manifest>